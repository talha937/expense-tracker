      "name": "Create Expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Visualization Script",
              "// Visualization Script",
              "const template = `",
              "<style>",
              "  body { font-family: Arial, sans-serif; padding: 16px; }",
              "  table { border-collapse: collapse; width: 100%; }",
              "  th, td { border: 1px solid #ddd; padding: 8px 12px; text-align: left; }",
              "  th { background: #f5f5f5; font-weight: 600; }",
              "  tr:nth-child(even) { background: #fafafa; }",
              "  a { color: #0366d6; text-decoration: none; }",
              "  a:hover { text-decoration: underline; }",
              "  pre { background: #f6f8fa; padding: 12px; border: 1px solid #ddd; border-radius: 4px; white-space: pre-wrap; word-break: break-word; }",
              "</style>",
              "{{#if isTable}}",
              "  <table>",
              "    <thead>",
              "      <tr>",
              "        <th>Resource</th>",
              "        <th>URL</th>",
              "      </tr>",
              "    </thead>",
              "    <tbody>",
              "      {{#each rows}}",
              "        <tr>",
              "          <td>{{resource}}</td>",
              "          <td><a href=\"{{url}}\" target=\"_blank\">{{url}}</a></td>",
              "        </tr>",
              "      {{/each}}",
              "    </tbody>",
              "  </table>",
              "{{#unless isTable}}",
              "  <pre>{{prettyJson}}</pre>",
              "{{/unless}}",
              "{{/if}}`;",
              "",
              "function createPayload() {",
              "  let data;",
              "",
              "  try {",
              "    data = pm.response.json();",
              "  } catch (e) {",
              "    return {",
              "      isTable: false,",
              "      prettyJson: pm.response.text()",
              "    };",
              "  }",
              "",
              "  const isPlainObject = data && typeof data === 'object' && !Array.isArray(data);",
              "  const entries = isPlainObject ? Object.entries(data) : [];",
              "  const canRenderTable = isPlainObject && entries.length > 0 && entries.every(([key, value]) => {",
              "    const primitive = ['string', 'number', 'boolean'].includes(typeof value) || value === null;",
              "    return typeof key === 'string' && primitive;",
              "  });",
              "",
              "  if (canRenderTable) {",
              "    return {",
              "      isTable: true,",
              "      rows: entries.map(([resource, url]) => ({",
              "        resource,",
              "        url: String(url)",
              "      }))",
              "    };",
              "  }",
              "",
              "  return {",
              "    isTable: false,",
              "    prettyJson: JSON.stringify(data, null, 2)",
              "  };",
              "}",
              "",
              "pm.visualizer.set(template, createPayload());",
              "",
              "const response = pm.response.json();",
              "pm.environment.set(\"expense_id\", response.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
